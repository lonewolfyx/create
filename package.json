{
    "name": "@lonewolfyx/create",
    "type": "module",
    "version": "0.0.13",
    "packageManager": "pnpm@10.34.9",
    "description": "Command-line for creating projects from templates.",
    "author": "lonewolfyx <olddrivero.king@qq.com>",
    "license": "MIT",
    "homepage": "https://github.com/lonewolfyx/create#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lonewolfyx/create.git"
    },
    "bugs": {
        "url": "https://github.com/lonewolfyx/create/issues"
    },
    "keywords": [
        "create",
        "template"
    ],
    "exports": {
        ".": "./dist/index.mjs",
        "./package.json": "./package.json"
    },
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "bin": {
        "new": "./bin/cli.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "prepublishOnly": "pnpm build"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "dependencies": {
        "@clack/prompts": "^0.11.0",
        "cac": "^6.7.14",
        "defu": "^6.1.7",
        "find-up": "^8.0.0",
        "giget": "^2.0.0",
        "glob": "^13.0.6",
        "jiti": "^2.7.0",
        "replace-in-file": "^8.4.0",
        "tinyexec": "^1.3.1"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^6.7.3",
        "@lonewolfyx/tsconfig": "^0.0.6",
        "@types/node": "^25.9.9",
        "eslint": "^9.39.5",
        "lint-staged": "^16.4.0",
        "picocolors": "^1.1.1",
        "simple-git-hooks": "^2.14.0",
        "tsdown": "^0.23.2",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged",
        "commit-msg": "node scripts/verify-commit.js"
    },
    "lint-staged": {
        "*": "eslint --fix"
    }
}
